    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "ejs": "^3.1.7",
    "express": "^4.17.1",
    "express-rate-limit": "^6.1.0",
    "express-session": "^1.19.0",
    "find-up": "^3.0.0",
    "form-urlencoded": "^4.0.0",
    "http-proxy": "^1.18.0",
    "ioredis": "^6.0.0",
    "ioredis-mock": "file:vendor/ioredis-mock-8.13.1-eg.1.tgz",
    "js-yaml": "^3.13.1",
    "json-schema-merge-allof": "^0.6.0",
    "json-schema-ref-parser": "^7.1.1",
    "jsonwebtoken": "^9.0.3",
    "lodash.flatmap": "^4.5.0",
    "minimatch": "^3.0.4",
