    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-node": "^10.0.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "find-free-port": "2.0.0",
    "husky": "^3.0.5",
    "istanbul": "0.4.5",
    "lint-staged": "^9.2.5",
    "mocha": "^12.0.3",
    "mocha-lcov-reporter": "1.3.0",
    "nyc": "^18.0.0",
    "puppeteer": "^25.18.1",
    "rimraf": "^3.0.0",
    "should": "^13.2.3",
    "sinon": "^7.4.2",
    "supertest": "^4.0.2",
    "supertest-session": "^4.0.0",
    "tmp": "^0.2.7",
    "yeoman-test": "^11.8.2"
  },
  "bundleDependencies": [
    "ioredis-mock"
  ],
  "overrides": {
    "glob@>=9 <14.0.2": "^14.0.6",
    "minimatch@>=7 <11": "^11.0.9",
    "flatted": "^3.4.2",
    "external-editor": {
      "tmp": "^0.2.7"
    },
    "@tootallnate/once": "^2.0.1",
    "sinon": {
      "diff": "^3.5.1"
    },
    "teeny-request": {
      "uuid": "$uuid"
    }
  },
  "yargs": {
    "boolean-negation": false
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
